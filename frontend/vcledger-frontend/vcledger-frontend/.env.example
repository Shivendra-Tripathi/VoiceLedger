# Copy this file to .env and adjust as needed.
# Local development backend URL. Set VITE_API_BASE_URL in Vercel to the
# deployed HTTPS backend URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api

# The localStorage key your existing login page saves the JWT under.
# Must match exactly, or the app will not find the token.
VITE_JWT_STORAGE_KEY=vcledger_token
